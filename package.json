{
  "name": "dsh-self-improvement",
  "description": "DSH cross-session self-improvement: memory, error/session retrospectives, SOP extraction and improvement proposals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "dxxCaO",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "self-improvement",
    "memory",
    "retrospective",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxxCaO/dsh-self-improvement.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node tests/smoke.mjs && node tests/contract.mjs && node tests/audit.mjs && node tests/memory-regression.mjs && node tests/aux-effort.mjs && node tests/scope-visible.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
